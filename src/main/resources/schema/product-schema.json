{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Product",
    "description": "Product schema with nested details",
    "type": "object",
    "required": [
        "name",
        "details"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "details": {
            "type": "object",
            "required": [
                "price"
            ],
            "properties": {
                "price": {
                    "type": "object",
                    "required": [
                        "value",
                        "unit"
                    ],
                    "properties": {
                        "value": {
                            "type": "number",
                            "minimum": 0
                        },
                        "unit": {
                            "type": "string",
                            "enum": [
                                "USD",
                                "EUR",
                                "GBP"
                            ]
                        }
                    }
                },
                "description": {
                    "type": "string"
                }
            }
        }
    }
}